# Environment variables for local development.
#
# Almost all of services/docker-compose.yml's values (Postgres user/pass, JWT_SECRET,
# per-service DB URLs, etc.) are hardcoded demo defaults, since this stack is only ever
# run locally — see services/docker-compose.yml and each service's application-dev.yml.
# The variables below are the ones actually read from the environment.

# Frontend (copy to frontend/.env) — Vite dev server's API target.
VITE_API_BASE_URL=http://localhost:8080

