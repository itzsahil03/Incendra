        {
          "name": "List Chat Messages",
          "description": "Expect your message above PLUS a system message per workflow transition you ran in folder 06 ('State changed: Open → Acknowledged', etc).",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/chat/incidents/{{incidentId}}/messages"
          },
          "response": []
        },
        {
          "name": "Live Incident Room (WebSocket)",
          "description": "Postman's native WebSocket request type. The ?token= query param is required — the handshake is validated by WebSocketAuthInterceptor (a browser WebSocket client can't attach an Authorization header, so the JWT travels as a query param instead; connecting without a valid token now gets rejected with 401, where previously any connection was accepted unauthenticated). Connect, then re-run 'Post Chat Message' above in a second tab/request — the new message should arrive here in real time.",
          "request": {
            "method": "GET",
            "url": "ws://localhost:8080/api/ws/incidents/{{incidentId}}?token={{token}}"
          },
          "protocolProfileBehavior": { "disabledSystemHeaders": {} },
          "response": []
        }
      ]
